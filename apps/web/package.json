{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "imports": {
    "#components/*": "./components/*.tsx",
    "#lib/*": "./lib/*.ts",
    "#hooks/*": "./hooks/*.ts"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "postinstall": "node ./scripts/link-postcss-deps.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/ui": "*",
    "@tailwindcss/postcss": "^4.1.11",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "10.9.1",
    "jsdom": "^27.0.0",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
